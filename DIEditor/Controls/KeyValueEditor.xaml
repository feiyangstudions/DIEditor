<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DIEditor.Controls.KeyValueEditor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DIEditor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- ① DataTemplate 内同样支持 x:Uid：模板被实例化时，
             解析器会对每个元素单独做一次资源查找，与模板外的行为一致。
             注意模板内的 x:DataType 是 KeyValueItem，所以这里无法 x:Bind
             到控件自身的依赖属性——这是选 x:Uid 而非绑定的根本原因。 -->
        <DataTemplate x:Key="KeyValueRowTemplate" x:DataType="local:KeyValueItem">

            <!-- 每行外框：圆角 + 淡描边 + 卡片底色，让相邻条目在视觉上分开 -->
            <Border Margin="0,0,0,8"
                    Padding="8"
                    CornerRadius="6"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">

                <!-- 五列：浏览 | 键 | 竖线 | 值 | 删除；另有一行专门显示校验错误 -->
                <Grid ColumnSpacing="8" RowSpacing="4">

                    <Grid.ColumnDefinitions>
                        <!-- 0：浏览按钮，宽度随文字自适应 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 1：左输入框（键），星号宽度参与伸缩 -->
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <!-- 2：中间分割线，固定宽度，不参与伸缩 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 3：右输入框（值） -->
                        <ColumnDefinition Width="*" MinWidth="90" />
                        <!-- 4：最右侧删除按钮 -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- ==================== 最左：浏览文件 ==================== -->
                    <!-- ② 按钮的 Content 是显式的 StackPanel，所以这里只挂
                         ToolTipService.ToolTip 与 AutomationProperties.Name 两条键，
                         resw 中绝不能出现 KVE_BrowseButton.Content，
                         否则图标+文字会被整体替换成一段纯文本。 -->
                    <Button Grid.Row="0" Grid.Column="0"
                            x:Uid="KVE_BrowseButton"
                            Height="32"
                            Padding="10,0"
                            VerticalAlignment="Center"
                            Click="BrowseItem_Click"
                            Tag="{x:Bind}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE8E5;" FontSize="13" />
                            <!-- ③ 按钮上的可见文字改挂在内层 TextBlock 上，
                                 键名是 KVE_BrowseLabel.Text。 -->
                            <TextBlock x:Uid="KVE_BrowseLabel" FontSize="13" />
                        </StackPanel>
                    </Button>

                    <!-- ==================== 左：键输入框 ==================== -->
                    <!-- ④ Text 上有 TwoWay 绑定，resw 中只允许出现
                         PlaceholderText 与 AutomationProperties.Name 两条键。
                         若写了 KVE_KeyBox.Text，资源值会覆盖绑定，
                         输入框将永远显示那一段固定文字。 -->
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Uid="KVE_KeyBox"
                             Text="{x:Bind Key, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- ==================== 中：1px 竖线 ==================== -->
                    <Border Grid.Row="0" Grid.Column="2"
                            Width="1"
                            Margin="0,4"
                            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <!-- ==================== 右：值输入框 ==================== -->
                    <TextBox Grid.Row="0" Grid.Column="3"
                             x:Uid="KVE_ValueBox"
                             Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- ==================== 最右：删除本行 ==================== -->
                    <!-- ⑤ 内容是一个 FontIcon，同样不写 .Content 键。 -->
                    <Button Grid.Row="0" Grid.Column="4"
                            x:Uid="KVE_DeleteButton"
                            Width="36" Height="32" Padding="0"
                            Click="DeleteItem_Click"
                            Tag="{x:Bind}">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" />
                    </Button>

                    <!-- ==================== 校验提示 ==================== -->
                    <!-- ⑥ 这段文字来自 KeyValueItem.ValidationMessage，
                         是代码侧生成的本地化文本，因此不挂 x:Uid。 -->
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                               Text="{x:Bind ValidationMessage, Mode=OneWay}"
                               Visibility="{x:Bind ErrorVisibility, Mode=OneWay}"
                               Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Style="{StaticResource CaptionTextBlockStyle}"
                               TextWrapping="Wrap" />

                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <!-- 根布局：上面列表，下面“列表之外”的操作区 -->
    <Grid RowSpacing="8" MaxHeight="250">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 外部需给本控件一个确定高度（Height 或放在 * 行），ScrollViewer 才会真正滚动 -->
        <ScrollViewer Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Auto"
                      HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,4,0">

            <ItemsControl x:Name="RowItemsControl"
                          ItemsSource="{x:Bind Items, Mode=OneWay}"
                          ItemTemplate="{StaticResource KeyValueRowTemplate}">

                <!-- ItemsControl 默认不横向拉伸容器，不写这段每行只有内容那么宽 -->
                <ItemsControl.ItemContainerStyle>
                    <Style TargetType="ContentPresenter">
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ItemsControl.ItemContainerStyle>

                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== 列表之外的按钮区 ==================== -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ⑦ 与本文件里两个按钮同理：Content 是显式 StackPanel，
                 只挂内层 TextBlock 的 x:Uid。 -->
            <Button Grid.Column="0" Click="AddItem_Click">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE710;" FontSize="14" />
                    <TextBlock x:Uid="KVE_AddLabel" />
                </StackPanel>
            </Button>

            <!-- ⑧ 状态栏文本由 RefreshStatus() 用 L.Format 生成，不挂 x:Uid。 -->
            <TextBlock x:Name="StatusTextBlock"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Right"
                       Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>

    </Grid>
</UserControl>
