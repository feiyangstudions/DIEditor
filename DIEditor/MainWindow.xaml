<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DIEditor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DIEditor"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:cont="using:DIEditor.Controls"
    mc:Ignorable="d"
    Closed="Window_Closed"
    Title="DIEditor">

    <Window.SystemBackdrop>
        <MicaBackdrop/>
    </Window.SystemBackdrop>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TitleBar x:Uid="TitleBar" x:Name="Titlebar">
            <TitleBar.Resources>
                <HorizontalAlignment x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="/Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>
        <ScrollView  Grid.Row="1" ContentOrientation="Both">
            <Grid Margin="30" RowSpacing="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 第1行-读取文件夹 -->
                <StackPanel Grid.Row="0" Padding="15" CornerRadius="8" Orientation="Horizontal" Spacing="10"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBox x:Uid="RawDirPathTextBox" x:Name="RawDirPathTextBox" MinWidth="300"
                             TextChanged="RawDirPathTextBox_TextChanged"/>
                    <Button x:Uid="RawDirPathPickButton" x:Name="RawDirPathPickButton"
                        VerticalAlignment="Bottom"
                        Click="RawDirPathPickButton_Click"/>
                    <Button x:Uid="LoadRawDirButton" x:Name="LoadRawDirButton"
                        VerticalAlignment="Bottom"
                        Click="LoadRawDirButton_Click"/>
                    <Button x:Uid="ClearDirDIButton" x:Name="ClearDirDIButton"
                            VerticalAlignment="Bottom" Click="ClearDirDIButton_Click"/>
                </StackPanel>
                <!-- 第2行内容 -->
                <Grid ColumnSpacing="20" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 第1列-自定义名称 -->
                    <Grid Grid.Column="0" Grid.Row="1" RowSpacing="10" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Uid="CustomNameCheckBox" x:Name="CustomNameCheckBox" IsEnabled="False"
                              Checked="CustomNameCheckBox_Checked"
                              Unchecked="CustomNameCheckBox_Unchecked"/>
                        <TextBox Grid.Row="1" x:Name="CustomNameTextBox"
                                 x:Uid="CustomNameTextBox"
                                 IsEnabled="False"/>
                    </Grid>
                    <!-- 第2列-自定义图标 -->
                    <Grid Grid.Column="1" Grid.Row="1" RowSpacing="10" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CustomIconCheckBox" IsEnabled="False"
                                  x:Uid="CustomIconCheckBox"
                              Checked="CustomIconCheckBox_Checked"
                              Unchecked="CustomIconCheckBox_Unchecked"/>
                        <StackPanel  Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="CustomIconPathTextBox" 
                                     x:Uid="CustomIconPathTextBox"
                                 IsEnabled="False"/>
                            <Button x:Name="CustomIconPathSelectButton"
                                    x:Uid="CustomIconPathSelectButton"
                                Click="CustomIconPathSelectButton_Click"
                                IsEnabled="False"/>
                        </StackPanel>
                        <NumberBox x:Name="CustomIconIndexNumberBox" Grid.Row="2"
                                   x:Uid="CustomIconIndexNumberBox"
                               PlaceholderText="0"
                               Value="0" ValueChanged="CustomIconIndexNumberBox_ValueChanged"
                               SpinButtonPlacementMode="Inline"
                               SmallChange="1"
                               LargeChange="5"
                               IsEnabled="False"/>
                    </Grid>
                    <!-- 第3列-自定义悬停提示 -->
                    <Grid Grid.Column="2" Grid.Row="1" RowSpacing="10" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CustomTooltipCheckBox" IsEnabled="False"
                                  x:Uid="CustomTooltipCheckBox"
                              Checked="CustomTooltipCheckBox_Checked"
                              Unchecked="CustomTooltipCheckBox_Unchecked"/>
                        <TextBox Grid.Row="1" x:Name="CustomTooltipTextBox"
                                 x:Uid="CustomTooltipTextBox"
                             IsEnabled="False"/>
                    </Grid>
                    <!-- 第4列-自定义文件名 -->
                    <Grid Grid.Column="3" Grid.Row="1" RowSpacing="10" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                      Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <CheckBox x:Name="CustomFileNameCheckBox" IsEnabled="False"
                                  x:Uid="CustomFileNameCheckBox"
                              Checked="CustomFileNameCheckBox_Checked"
                              Unchecked="CustomFileNameCheckBox_Unchecked"/>
                        <cont:KeyValueEditor Grid.Row="1" x:Name="CustomFileNameEditor"
                       IsEnabled="False"/>
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="2" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock x:Uid="AdvancedOptions" FontWeight="Bold"/>
                    <CheckBox IsChecked="True" x:Name="DIHiddenCheckBox" x:Uid="DIHiddenCheckBox"
                              IsEnabled="False"/>
                    <CheckBox IsChecked="True" x:Name="DISystemCheckBox" x:Uid="DISystemCheckBox"
                              IsEnabled="False"/>
                    <ComboBox SelectedIndex="0" x:Name="DIEncodingComboBox" x:Uid="DIEncodingComboBox"
                              SelectionChanged="DIEncodingComboBox_SelectionChanged"
                              IsEnabled="False">
                        <ComboBoxItem x:Uid="EncodingUtf16LE"/>
                        <ComboBoxItem x:Uid="EncodingAnsi"/>
                    </ComboBox>
                </StackPanel>
                <!-- 第4行-生成与保存 -->
                <Grid Grid.Row="3" RowSpacing="10" Padding="15" CornerRadius="8" VerticalAlignment="Top"
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button x:Name="GenerateButton" IsEnabled="False"
                                x:Uid="GenerateButton"
                            Click="GenerateButton_Click"/>
                        <Button x:Name="SaveButton" x:Uid="SaveButton"
                                IsEnabled="False"
                            Click="SaveButton_Click"/>
                    </StackPanel>
                    <TextBox x:Name="DIPreviewTextBox" Grid.Row="1"
                             x:Uid="DIPreviewTextBox"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             IsEnabled="False"/>
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</Window>
